<configuration>
    <appender name="logcat" class="ch.qos.logback.classic.android.LogcatAppender">
        <tagEncoder><pattern>%logger{12}</pattern></tagEncoder>
        <encoder><pattern>%msg</pattern></encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="logcat" />
    </root>
</configuration>
